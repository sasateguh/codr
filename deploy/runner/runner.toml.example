# codr-runner configuration (D89). Copy to runner.toml with mode 0600: it holds the token and the webhook secrets.
listen         = "0.0.0.0:3200"             # inside the container; publish it on the host as 127.0.0.1:3200
forge_url      = "http://codr:3000"         # Codr on the internal network (clone + status API)
public_url     = "https://git.example.com"  # log links: <public_url>/ci/log/<id>
token          = "codr_…"                   # repo:write token of the runner account (e.g. codr-ci, a write collaborator)
webhook_secret = ""                         # optional shared secret; Codr makes one secret PER webhook, so usually use [secrets]
lang           = "en-US"                    # language of check messages (en-US or ms-MY)
work_dir       = "/srv/codr-runner/work"    # the SAME path on the host and in the container
log_dir        = "/srv/codr-runner/log"
concurrency    = 1
timeout_minutes = 15
memory         = "1g"
cpus           = "1"
pids           = 256
tmp_size       = "256m"
allow_network  = false                      # true = jobs may download dependencies
repos          = ["you/*"]                  # repositories served (glob); empty = every repository with a valid webhook

[secrets]                                   # webhook secret per repository (shown once when the webhook is created)
"you/project" = "…"
