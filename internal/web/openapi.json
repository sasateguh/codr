 "components": {
  "securitySchemes": {
   "token": {
    "type": "http",
    "scheme": "bearer",
    "description": "A Codr access token (codr_…), never a password."
   }
  },
  "parameters": {
   "owner": {
    "name": "owner",
    "in": "path",
    "required": true,
    "description": "Owner (person or organisation)",
    "schema": {
     "type": "string"
    }
   },
   "repo": {
    "name": "repo",
    "in": "path",
    "required": true,
    "description": "Repository name",
    "schema": {
     "type": "string"
    }
   },
   "n": {
    "name": "n",
    "in": "path",
    "required": true,
    "description": "Issue or pull request number",
    "schema": {
     "type": "integer"
    }
   },
   "sha": {
    "name": "sha",
    "in": "path",
    "required": true,
    "description": "Commit id (40 hex)",
    "schema": {
     "type": "string"
    }
   },
   "path": {
    "name": "path",
    "in": "path",
    "required": true,
    "description": "Path inside the repository",
    "schema": {
     "type": "string"
    }
   },
   "ref": {
    "name": "ref",
    "in": "query",
    "required": false,
    "description": "Branch, tag or commit (default branch when absent)",
    "schema": {
     "type": "string"
    }
   },
   "path_q": {
    "name": "path",
    "in": "query",
    "required": false,
    "description": "Only commits touching this path",
    "schema": {
     "type": "string"
    }
   },
   "q": {
    "name": "q",
    "in": "query",
    "required": false,
    "description": "Search text",
    "schema": {
     "type": "string"
    }
   },
   "owner_q": {
    "name": "owner",
    "in": "query",
    "required": false,
    "description": "Only this owner's repositories",
    "schema": {
     "type": "string"
    }
   },
   "state": {
    "name": "state",
    "in": "query",
    "required": false,
    "description": "open (default), closed or all",
    "schema": {
     "type": "string",
     "enum": [
      "open",
      "closed",
      "all"
     ]
    }
   },
   "pstate": {
    "name": "state",
    "in": "query",
    "required": false,
    "description": "open (default), closed, merged or all",
    "schema": {
     "type": "string",
     "enum": [
      "open",
      "closed",
      "merged",
      "all"
     ]
    }
   },
   "page": {
    "name": "page",
    "in": "query",
    "required": false,
    "description": "Page, from 1",
    "schema": {
     "type": "integer",
     "minimum": 1
    }
   },
   "per_page": {
    "name": "per_page",
    "in": "query",
    "required": false,
    "description": "Items per page (setting api.per_page_max bounds it)",
    "schema": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "error",
     "message"
    ]
   },
   "IssueIn": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 200
     },
     "body": {
      "type": "string"
     },
     "state": {
      "type": "string",
      "enum": [
       "open",
       "closed"
      ]
     }
    }
   },
   "CommentIn": {
    "type": "object",
    "properties": {
     "body": {
      "type": "string"
     }
    },
    "required": [
     "body"
    ]
   },
   "StatusIn": {
    "type": "object",
    "properties": {
     "state": {
      "type": "string",
      "enum": [
       "pending",
       "success",
       "failure",
       "error"
      ]
     },
     "context": {
      "type": "string",
      "maxLength": 100,
      "default": "default"
     },
     "description": {
      "type": "string",
      "maxLength": 200
     },
     "target_url": {
      "type": "string",
      "format": "uri"
     }
    },
    "required": [
     "state"
    ]
   },
   "AssigneesIn": {
    "type": "object",
    "required": [
     "assignees"
    ],
    "properties": {
     "assignees": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "user names; an assignee needs write access, or read access and a part in the thread"
     }
    }
   }
  },
  "responses": {
   "Error": {
    "description": "Error",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
