{
 "openapi": "3.1.0",
 "info": {
  "title": "Codr API",
  "version": "1",
  "description": "REST API v1 of a Codr forge. Authenticate with an access token made on /akaun: Authorization: Bearer codr_…. Without a token you see what an anonymous visitor sees. What a call may do is the person's access, capped by the token's scope (repo:read, repo:write). A repository you cannot read answers 404. Lists take page and per_page and send X-Total-Count. Changes made here fire the same webhooks and notifications as the web pages."
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "security": [
  {
   "token": []
  },
  {}
 ],
